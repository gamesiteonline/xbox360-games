# ============================================
# GAMESITEONLINE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MySQL/TiDB connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/gamesiteonline

# ============================================
# AUTHENTICATION (Manus OAuth)
# ============================================
# Get these from Manus dashboard
JWT_SECRET=your-super-secret-jwt-key-change-this
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im/oauth
OWNER_OPEN_ID=your-owner-openid
OWNER_NAME=Fahad

# ============================================
# MANUS BUILT-IN APIS
# ============================================
# Server-side API key
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your-server-side-api-key

# Frontend API key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-api-key

# ============================================
# ANALYTICS (Optional)
# ============================================
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com/umami
VITE_ANALYTICS_WEBSITE_ID=your-analytics-id

# ============================================
# BRANDING
# ============================================
# Customize per platform
VITE_APP_TITLE=Gamesiteonline - DOS Games
VITE_APP_LOGO=https://your-cdn.com/logo.png

# ============================================
# PAYMENT PROCESSING (Optional - Stripe)
# ============================================
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================
# EMAIL SERVICE (Optional - SendGrid)
# ============================================
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@gamesiteonline.com

# ============================================
# PUSH NOTIFICATIONS (Optional - Firebase)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# ============================================
# SOCIAL MEDIA
# ============================================
WHATSAPP_LINK=https://wa.me/qr/FYVTX2AFYSUVH1
WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbChyDUI1rcht5jajL3q
INSTAGRAM_PROFILE=https://www.instagram.com/ard.sing
THREADS_PROFILE=https://www.threads.com/@ard.sing

# ============================================
# COMPANY INFO
# ============================================
COMPANY_NAME=Gamesiteonline
COMPANY_LOCATION=Tanzania
OWNER_NAME=Fahad
COMPANY_EMAIL=contact@gamesiteonline.com

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_RECOMMENDATIONS=true
ENABLE_GAMIFICATION=true
ENABLE_COMMUNITY=true
ENABLE_ANALYTICS=true
ENABLE_MEDIA=true
ENABLE_MONETIZATION=true
ENABLE_NOTIFICATIONS=true
ENABLE_CUSTOMIZATION=true

# ============================================
# DEVELOPMENT
# ============================================
DEBUG=false
LOG_LEVEL=info
NODE_ENV=development
